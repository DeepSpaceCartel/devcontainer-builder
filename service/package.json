{
  "name": "@deepspacecartel/devcontainer-builder",
  "version": "0.1.0",
  "description": "Builds a container image from a git repository's .devcontainer.json using a remote BuildKit builder, and pushes it to a registry.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepSpaceCartel/devcontainer-builder.git",
    "directory": "service"
  },
  "license": "MIT",
  "keywords": [
    "devcontainer",
    "devcontainers",
    "buildkit",
    "coder",
    "kubernetes"
  ],
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "bin": {
    "devcontainer-builder": "bin/devcontainer-builder.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:unit": "node --import tsx --import ./src/testing/setup.ts --test src/*.test.ts",
    "test:coverage": "node --import tsx --import ./src/testing/setup.ts --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/testing/**' src/*.test.ts",
    "test:feature": "node scripts/test-feature.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.74.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.4",
    "jsonc-parser": "^3.3.1",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@redocly/cli": "^2.53.2",
    "@types/node": "^26.6.4",
    "thomas": "github:DeepSpaceCartel/thomas#1c5f12cd2e3430a62a1df36a9f924741864c12e2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
