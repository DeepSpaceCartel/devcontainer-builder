{
  "name": "devcontainer-builder-rebuild",
  "displayName": "Dev Containers for Coder",
  "description": "Clone a repository into a new Coder workspace built from its devcontainer.json, and rebuild the workspace when that configuration changes on its branch.",
  "version": "0.0.0",
  "publisher": "deepspacecartel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepSpaceCartel/devcontainer-builder.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devcontainerBuilder.cloneInWorkspace",
        "title": "Clone Repository in Workspace...",
        "category": "Coder"
      },
      {
        "command": "devcontainerBuilder.check",
        "title": "Check for Rebuild",
        "category": "Dev Container"
      },
      {
        "command": "devcontainerBuilder.rebuild",
        "title": "Rebuild Workspace",
        "category": "Dev Container"
      }
    ],
    "configuration": {
      "title": "Dev Containers for Coder",
      "properties": {
        "devcontainerBuilder.checkIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "How often to fetch the workspace's branch and check for Dev Container changes. 0 checks only on start and on demand."
        },
        "devcontainerBuilder.coderUrl": {
          "type": "string",
          "default": "",
          "description": "Coder deployment for Clone Repository in Coder Workspace. Empty: the one you're logged in to with the Coder CLI, else asked once."
        },
        "devcontainerBuilder.template": {
          "type": "string",
          "default": "",
          "description": "Coder template new workspaces are created from (its name). Empty: the only template asking for a repository and a branch, else asked."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "devcontainerBuilder.check",
          "when": "devcontainerBuilder.inWorkspace"
        },
        {
          "command": "devcontainerBuilder.rebuild",
          "when": "devcontainerBuilder.inWorkspace"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "package": "cp ../LICENSE LICENSE && vsce package --out devcontainer-builder-rebuild.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
